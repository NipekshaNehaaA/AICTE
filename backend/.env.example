# AICTE Approval & Compliance Automation Platform Environment Configuration
# Copy this file to .env and configure for your environment.

# Environment Mode: 'development' or 'production'
ENV=development

# Demonstration & Evaluation Mode (OFF by default for production security)
# Set to 'true' during evaluation to enable 1-click persona tokens and accelerated time travel
DEMO_MODE=false

# JWT Secret Key (REQUIRED in production mode: must be >= 32 characters and cryptographically strong)
# Example generated with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secure-at-least-32-chars-long-jwt-secret-key-here

# Database Connection (SQLite default for development; PostgreSQL for production with RLS)
DATABASE_URL=sqlite:///./aicte_dev.db
# DATABASE_URL=postgresql://aicte_user:aicte_password@localhost:5432/aicte_db

# File Storage Service Backend ('local' or 'minio')
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aicte-documents
MINIO_SECURE=false

# Email Notification Gateway (Mailpit in development; production SMTP / SendGrid / Resend)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aicte-india.org
SMTP_TLS=false

# WhatsApp Sandbox Adapter (Optional; operates in SIMULATED mode if unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
